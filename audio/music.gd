extends Node

## Looping 8-bit background music on its own bus. The track is an original
## 16-bar chiptune generated by tools/generate_bgm.py.

const BGM_STREAM = preload("res://audio/music/deduction_loop.ogg")

const BUS_NAME := "Music"
## Keeps the loop comfortably under the transient SFX.
const MUSIC_GAIN_DB := -20.0
const FADE_IN := 1.6

var controller = null
var enabled := false
var muted := false
var volume := 0.8

var _player: AudioStreamPlayer = null
var _fade: Tween = null

## Create the looping player unless running headless.
func setup(p_controller = null) -> void:
	controller = p_controller
	if DisplayServer.get_name() == "headless":
		return
	_ensure_bus()
	_player = AudioStreamPlayer.new()
	_player.bus = BUS_NAME
	_player.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_player)
	var stream: AudioStream = BGM_STREAM
	if stream is AudioStreamOggVorbis:
		stream.loop = true
	_player.stream = stream
	_player.volume_db = -40.0
	_player.play()
	enabled = true
	_apply_volume()
	_fade_in()

## Create the Music bus if the project bus layout does not provide one.
func _ensure_bus() -> void:
	if AudioServer.get_bus_index(BUS_NAME) >= 0:
		return
	AudioServer.add_bus()
	var index := AudioServer.bus_count - 1
	AudioServer.set_bus_name(index, BUS_NAME)
	AudioServer.set_bus_send(index, "Master")

## Apply the shared mute/volume state to the Music bus.
func _apply_volume() -> void:
	var index := AudioServer.get_bus_index(BUS_NAME)
	if index < 0:
		return
	AudioServer.set_bus_volume_db(
		index,
		linear_to_db(maxf(volume, 0.0001)) + MUSIC_GAIN_DB
	)
	AudioServer.set_bus_mute(index, muted)

func set_muted(value: bool) -> void:
	muted = value
	_apply_volume()

func set_volume(value: float) -> void:
	volume = clampf(value, 0.0, 1.0)
	_apply_volume()

## Soft entry so the loop does not pop when the first page appears.
func _fade_in() -> void:
	if _player == null:
		return
	if _fade != null and _fade.is_valid():
		_fade.kill()
	_player.volume_db = -40.0
	_fade = create_tween()
	_fade.tween_property(
		_player, "volume_db", 0.0, FADE_IN
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)

func is_enabled() -> bool:
	return enabled
