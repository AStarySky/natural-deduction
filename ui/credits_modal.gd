extends "res://ui/title_modal.gd"

## Title-screen credits, including the attribution required by the CC-BY
## keyboard samples and the OFL fonts.

func _modal_title() -> String:
	return "CREDITS"

func _modal_width() -> float:
	return 760.0

func _build_body(body: VBoxContainer) -> void:
	body.add_child(
		UiStyle.make_display_label("MADE WITH PAPER, LOGIC & CHIPTUNE", 11, UiStyle.muted_text())
	)

	var scroll := ScrollContainer.new()
	scroll.custom_minimum_size = Vector2(0, 420)
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	body.add_child(scroll)

	var content := VBoxContainer.new()
	content.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	content.add_theme_constant_override("separation", 5)
	scroll.add_child(content)

	_section(content, "DESIGN & CODE", [
		"Natural Deduction — a block proof puzzle.",
		"Designed and built with Godot Engine 4.7.",
	])
	_section(content, "CURRICULUM", [
		"Proof exercises adapted from the included NDpack.pdf.",
	])
	_section(content, "MUSIC", [
		"Original 8-bit soundtrack composed for this project.",
		"80-second seamless loop, generated by tools/generate_bgm.py.",
	])
	_section(content, "SOUND EFFECTS", [
		"Paper & card foley: Kenney Casino Audio (CC0).",
		"UI sounds: Kenney Interface Sounds (CC0).",
		"Marimba: VSCO 2 Community Edition (CC0).",
		"Keyboard: “Single Key Press Sounds” by eklee / qubodup (CC-BY 3.0).",
	])
	_section(content, "FONTS", [
		"Baloo 2, Nunito, Patrick Hand — SIL Open Font License 1.1.",
	])
	_section(content, "SPECIAL THANKS", [
		"Godot Engine and the open-source audio and font communities.",
		"Thank you for playing.",
	])

	var note := UiStyle.make_label_colored(
		"Full license texts are included with the game.",
		11,
		UiStyle.muted_text()
	)
	note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	note.clip_text = false
	note.custom_minimum_size = Vector2(0, 18)
	body.add_child(note)

	_add_footer(body, "CLOSE")

func _section(parent: VBoxContainer, title: String, lines: Array) -> void:
	var header := UiStyle.make_display_label(title, 12, UiStyle.muted_text())
	header.custom_minimum_size = Vector2(0, 20)
	parent.add_child(header)
	for line in lines:
		var label := UiStyle.make_label_colored(str(line), 13, UiStyle.text_color())
		label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		label.clip_text = false
		label.custom_minimum_size = Vector2(0, 20)
		parent.add_child(label)
	var gap := Control.new()
	gap.custom_minimum_size = Vector2(0, 6)
	gap.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(gap)
